# Copy this file to .env.local and fill in the values from your Neon project.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_test_secret_key
RESEND_API_KEY=re_replace_with_your_resend_api_key
RESEND_FROM_EMAIL=ShelfShare Books <library@example.com>
APP_URL=http://localhost:3000
CRON_SECRET=replace-with-a-random-secret-at-least-16-characters-long
LIBRARIAN_EMAIL=librarian@example.com
LIBRARIAN_PASSWORD=replace-with-a-unique-password
